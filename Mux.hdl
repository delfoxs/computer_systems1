// File name: projects/01/Mux.hdl

/** 
 * Multiplexor:
 * out = a if sel == 0
 *       b otherwise
 */

CHIP Mux {
    IN a, b, sel;
    OUT out;

    PARTS:
    // Put your code here:
    Not(in=a, out=na);
    Not(in=b, out=nb);
    Not(in=sel, out=nsel);
    And(a=na, b=b, out=out1);
    And(a=out1, b=sel, out=out1.1);

    And(a=a, b=nb, out=out2);
    And(a=out2, b=nsel, out=out2.1);

    And(a=a, b=b, out=out3);
    And(a=out3, b=nsel, out=out3.1);

    And(a=a, b=b, out=out4);
    And(a=out4, b=sel, out=out4.1);

    Or(a=out1.1,b=out2.1,out=out.1);
    Or(a=out3.1,b=out4.1,out=out.2);
    Or(a=out.1,b=out.2,out=out);
}